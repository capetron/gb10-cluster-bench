# Optional configuration. Copy to .env (never commit it) and export before running tools.

# OpenAI-compatible server key, if your engine requires one (bench/*)
OPENAI_API_KEY=

# Space-separated ssh aliases of the cluster nodes (node/*, cluster/*)
CLUSTER_HOSTS="node1 node2 node3 node4"

# Fabric NIC names on GB10 (node/verify-versions.sh, node/install-kho-hotfix.py)
FABRIC_NICS="enp1s0f0np0|enP2p1s0f0np0|enP7s7"
MTU_NIC=enp1s0f0np0

# UniFi PDU sampler (power/pdu-sample-unifi.sh); use a LOCAL read-only admin account
UNIFI_URL=https://192.168.1.1
UNIFI_USER=readonly-pdu
UNIFI_PASS_FILE=~/.config/unifi-pdu-pass

# Wall-power join in bench/speed.sh
PDU_TRACE=
PDU_OUTLETS=

# fleet-maint
FLEET_MAINT_POLICY=./fleet-maint/policy.yaml
FLEET_MAINT_APPROVALS=~/.config/fleet-maint/approvals.json
FLEET_MAINT_NOTIFY=
FLEET_MAINT_STATE=~/.local/state/fleet-maint
FLEET_MAINT_KILL=~/.config/fleet-maint/kill
FLEET_MAINT_PAUSE=~/.config/fleet-maint/pause
FLEET_MAINT_HOLDS=~/.config/fleet-maint/holds

# node/install-kho-hotfix.py and node/parity-check.sh
SUDO_PASSWORD_FILE=none
IGNORE_CONTAINERS=
EXPECT_SWAP_BYTES=17179869184

# power/pdu-sample-unifi.sh optional
UNIFI_SITE=default
PDU_MODEL=USPPDUP
OUTLET_MIN=1
OUTLET_MAX=32

# bench/speed.sh and bench/speedgate.sh knobs (see the script headers)
LADDER="1,4,8,16,32"
CEIL="48,64,96,128,192"
GATE_TOKENS=64
PREFILL_LENGTHS=
SKIP_GATE=
SKIP_CODE=
SKIP_CEILING=
SKIP_PREFILL=
GATE_OVERRIDE=
PFX=
